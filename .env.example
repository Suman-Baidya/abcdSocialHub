# ==============================================================================
# ABCD SOCIAL HUB — MASTER ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Architecture: Next.js 14 Monorepo + Prisma + PostgreSQL + Python FastAPI Worker
# Environments supported:
#   - Local Dev:     http://localhost:3000
#   - Short-Term QA: https://social.abcddigitalhub.com (Vercel + Neon)
#   - Full Prod:     https://abcdsocialhub.com (Dokploy Single VPS)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
# Local Development:
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Vercel Staging (social.abcddigitalhub.com):
# NEXT_PUBLIC_APP_URL=https://social.abcddigitalhub.com
# NEXT_PUBLIC_API_URL=https://social.abcddigitalhub.com/api

# Dokploy Production (abcdsocialhub.com):
# NODE_ENV=production
# APP_DOMAIN=abcdsocialhub.com
# NEXT_PUBLIC_APP_URL=https://abcdsocialhub.com
# NEXT_PUBLIC_API_URL=https://abcdsocialhub.com/api

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 16)
# ------------------------------------------------------------------------------
# Get your free Neon database in 60 seconds from https://console.neon.tech
# Copy the Prisma / pooled connection string:
DATABASE_URL="postgresql://neondb_owner:your_password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:your_password@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Later on Dokploy VPS (Internal Docker PostgreSQL):
# DATABASE_URL="postgresql://postgres:secure_db_password_here@postgres:5432/abcd_social?schema=public"

# ------------------------------------------------------------------------------
# 3. SMART MULTI-TIER AI GATEWAY (Cost-Optimized & Resilient)
# ------------------------------------------------------------------------------
# Universal AI Router (Access GPT-4o, Claude 3.5, DeepSeek, Llama via 1 unified key):
OPENROUTER_API_KEY=sk-or-v1-...

# TIER 1: High-Value Copywriting & Creative Hooks (OpenAI / Claude direct)
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-...

# TIER 2: Ultra Low-Cost / Free High-Speed Bulk Tasks (Groq / DeepSeek)
GROQ_API_KEY=gsk_...
DEEPSEEK_API_KEY=sk-...

# TIER 3: AI Background & Graphic Image Generation (Optional / Modular)
# Generates creative background visuals for promotional posters:
# (Options: OpenAI DALL-E, Stability AI, or Recraft)
IMAGE_AI_PROVIDER=openai # Options: openai | stability | recraft
STABILITY_API_KEY=sk-...
RECRAFT_API_KEY=...

# ------------------------------------------------------------------------------
# 4. MEDIA & ASSET STORAGE
# ------------------------------------------------------------------------------
# PRIMARY: Cloudinary (Images, Logos, Bengali/English Posters) - FREE TIER (25GB/mo)
# Get from https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# OPTIONAL: Cloudflare R2 (Heavy video storage & automated database backups)
# Only needed if generating long videos or storing multi-GB backups:
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=abcd-social-media
R2_PUBLIC_DOMAIN=

# ------------------------------------------------------------------------------
# 5. INTERNAL MICROSERVICES (Python Cairo Bengali/Poster Studio)
# ------------------------------------------------------------------------------
PYTHON_WORKER_URL=http://localhost:8000
INTERNAL_API_SECRET=generate_a_random_32_char_secret_here

# ------------------------------------------------------------------------------
# 6. AUTHENTICATION & SECURITY SECRETS
# ------------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_a_random_64_char_secret_here
TOKEN_ENCRYPTION_KEY=generate_a_32_byte_hex_key_here

# Super Admin & Developer Identities (Phases 1, 2 & 8)
DEVELOPER_EMAILS="suman.baidya.pro@gmail.com"
SUPER_ADMIN_EMAILS="suman.baidya.pro@gmail.com"

# Google OAuth (https://console.cloud.google.com) - Phase 2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 7. SOCIAL PLATFORMS & NOTIFICATIONS (Phases 5 & 6)
# ------------------------------------------------------------------------------
# Meta Developer Portal (https://developers.facebook.com) - Phase 6
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Resend Magic-Link & Email Alerts (https://resend.com) - Phase 5
RESEND_API_KEY=
EMAIL_FROM="ABCD Social <no-reply@abcdsocialhub.com>"
ADMIN_ALERT_EMAIL=founder@abcddigitalhub.com

# ------------------------------------------------------------------------------
# 8. INDIA BILLING & PAYMENTS (Phase 7)
# ------------------------------------------------------------------------------
# Razorpay Subscriptions (https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
