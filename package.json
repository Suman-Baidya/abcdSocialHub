{
  "name": "abcd-social-hub-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "ABCD Social Hub — AI Marketing Automation SaaS for Indian Small Businesses & Creators",
  "scripts": {
    "dev": "pnpm --filter @abcd/web dev",
    "dev:all": "concurrently -n \"web,worker\" -c \"cyan,yellow\" \"pnpm --filter @abcd/web dev\" \"cd apps/python-worker && uvicorn main:app --reload --port 8000\"",
    "build": "pnpm --recursive run build",
    "lint": "pnpm --recursive run lint",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test",
    "db:generate": "pnpm --filter @abcd/db generate",
    "db:push": "pnpm --filter @abcd/db push",
    "db:studio": "pnpm --filter @abcd/db studio"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "concurrently": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.0.0"
  }
}
